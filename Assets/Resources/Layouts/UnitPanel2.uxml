<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="UnitPanel" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); flex-basis: 90px; margin-bottom: 20px; margin-top: 20px; flex-direction: row; align-items: center; justify-content: center; align-self: center; margin-right: 10px; margin-left: 10px;">
        <ui:VisualElement name="PanelBG" style="flex-grow: 1; background-color: rgb(56, 62, 70); flex-direction: row; align-items: center; justify-content: center; align-self: stretch; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px;">
            <ui:VisualElement name="SpriteBG" style="flex-grow: 0; background-color: rgb(82, 166, 226); border-top-left-radius: 40px; border-bottom-left-radius: 40px; border-top-right-radius: 40px; border-bottom-right-radius: 40px; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(69, 74, 128); border-right-color: rgb(69, 74, 128); border-top-color: rgb(69, 74, 128); border-bottom-color: rgb(69, 74, 128); padding-top: 0; padding-bottom: 0; justify-content: center; align-items: center; align-self: center; width: 70px; height: 70px;">
                <ui:VisualElement name="Sprite" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); background-image: resource(&apos;img/creature/Untitled_Artwork&apos;); width: 70px; height: 70px; flex-basis: 100%; -unity-text-outline-color: rgb(56, 56, 56);" />
            </ui:VisualElement>
            <ui:Label tabindex="-1" text="Plant Lion" display-tooltip-when-elided="true" name="NameLabel" style="margin-left: 6px; font-size: 16px; color: rgb(255, 255, 255); margin-right: 6px;" />
            <ui:VisualElement name="LevelBG" style="flex-grow: 0; background-color: rgba(255, 77, 0, 0.87); justify-content: center; align-items: center; align-self: center; border-top-left-radius: 50px; border-bottom-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px;">
                <ui:Label tabindex="-1" text="13" display-tooltip-when-elided="true" name="LevelLabel" style="margin-left: 2px; font-size: 30px; color: rgb(255, 255, 255); margin-right: 2px; margin-top: 2px; margin-bottom: 2px;" />
            </ui:VisualElement>
            <ui:Button text="Create" display-tooltip-when-elided="true" name="CreateButton" style="background-color: rgb(140, 238, 147); font-size: 10px; padding-left: 20px; padding-right: 20px; padding-top: 12px; padding-bottom: 12px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
