        <ui:VisualElement name="CompleteIcon" style="flex-grow: 1; background-image: resource(&apos;img/icon/fatcat&apos;); background-color: rgba(255, 255, 255, 0); width: 100px; height: 100px; -unity-background-scale-mode: scale-to-fit;" />
