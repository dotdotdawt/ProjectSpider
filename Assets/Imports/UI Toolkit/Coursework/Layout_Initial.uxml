<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="Template_MiddleBadgeLocked" src="project://database/Assets/UI%20Toolkit/Coursework/Template_MiddleBadgeLocked.uxml?fileID=9197481963319205126&amp;guid=dd4da31d66bf8df46ac9c95214847473&amp;type=3#Template_MiddleBadgeLocked" />
    <ui:Template name="Template_MiddleBadgeUnlocked" src="project://database/Assets/UI%20Toolkit/Coursework/Template_MiddleBadgeUnlocked.uxml?fileID=9197481963319205126&amp;guid=0be81bc565b82af4c8a7308246e982cb&amp;type=3#Template_MiddleBadgeUnlocked" />
    <Style src="project://database/Assets/UI%20Toolkit/Coursework/StylesheetFirst.uss?fileID=7433441132597879392&amp;guid=d7410b95df85edd449c16063c5b32f53&amp;type=3#StylesheetFirst" />
    <ui:VisualElement name="MainContainer" style="flex-grow: 1; background-image: url(&apos;project://database/Assets/Resources/img/bg/background9.png?fileID=2800000&amp;guid=7156fde5efd6e8d42bbce5d7efa2ab66&amp;type=3#background9&apos;);">
        <ui:VisualElement name="TopContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; flex-basis: 80%;">
            <ui:VisualElement name="TopLeft" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-basis: 20%; justify-content: flex-end; margin-right: 10%;">
                <ui:VisualElement name="PanelMiniFraction" class="panel" style="margin-left: 30px; margin-right: 30px; margin-top: 30px; margin-bottom: 30px; padding-top: 0; padding-bottom: 0; flex-direction: row; border-bottom-left-radius: 70px; border-top-left-radius: 70px; border-top-right-radius: 0; border-bottom-right-radius: 0; -unity-text-align: upper-center;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); background-image: url(&apos;project://database/Assets/Resources/img/icon/mantrawhiteicon.png?fileID=2800000&amp;guid=efda021b417b7ed448eb6360ecf58671&amp;type=3#mantrawhiteicon&apos;); flex-wrap: nowrap; overflow: visible; -unity-background-scale-mode: scale-to-fit; height: 130px; width: 130px; flex-basis: 30%; margin-left: 20px; justify-content: center; align-items: center; align-self: center;" />
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-basis: 70%; justify-content: center; margin-left: 0;">
                        <ui:Label tabindex="-1" text="Capricorn" display-tooltip-when-elided="true" class="text_classic" style="font-size: 32px;" />
                        <ui:Label tabindex="-1" text="Ice/Earth" display-tooltip-when-elided="true" style="font-size: 26px;" />
                        <ui:Label tabindex="-1" text="Level 8" display-tooltip-when-elided="true" style="font-size: 30px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PanelCharacter" class="panel" style="flex-grow: 1; justify-content: flex-start; flex-basis: 80%; align-items: stretch; margin-left: 20px;" />
            </ui:VisualElement>
            <ui:VisualElement name="TopMiddle" style="flex-grow: 1; flex-basis: 60%; flex-direction: row; align-items: flex-end;">
                <ui:VisualElement name="PanelFaction" class="panel" style="flex-grow: 1; width: 35%; height: 80%;" />
                <ui:VisualElement name="PanelBadges" class="panel" style="flex-grow: 1; width: 10%; height: 80%;">
                    <ui:VisualElement name="BadgeElement" class="panel_badge" style="flex-grow: 1; flex-basis: auto; flex-wrap: nowrap; flex-direction: column; border-top-right-radius: 20px; border-top-left-radius: 20px; flex-shrink: 1;">
                        <ui:Instance template="Template_MiddleBadgeLocked" name="Template_MiddleBadgeLocked" />
                    </ui:VisualElement>
                    <ui:VisualElement name="BadgeElementComplete" class="panel_badge" style="flex-grow: 1; flex-basis: auto; flex-wrap: nowrap; flex-direction: column; margin-bottom: 0; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <ui:Instance template="Template_MiddleBadgeUnlocked" name="Template_MiddleBadgeUnlocked" />
                    </ui:VisualElement>
                    <ui:VisualElement name="BadgeElement" class="panel_badge" style="flex-grow: 1; flex-basis: auto; flex-wrap: nowrap; flex-direction: column; border-top-right-radius: 20px; border-top-left-radius: 20px; flex-shrink: 1;">
                        <ui:Instance template="Template_MiddleBadgeLocked" name="Template_MiddleBadgeLocked" />
                    </ui:VisualElement>
                    <ui:VisualElement name="BadgeElement" class="panel_badge" style="flex-grow: 1; flex-basis: auto; flex-wrap: nowrap; flex-direction: column; border-top-right-radius: 20px; border-top-left-radius: 20px; flex-shrink: 1;">
                        <ui:Instance template="Template_MiddleBadgeLocked" name="Template_MiddleBadgeLocked" />
                    </ui:VisualElement>
                    <ui:VisualElement name="BadgeElement" class="panel_badge" style="flex-grow: 1; flex-basis: auto; flex-wrap: nowrap; flex-direction: column; border-top-right-radius: 20px; border-top-left-radius: 20px; flex-shrink: 1;">
                        <ui:Instance template="Template_MiddleBadgeLocked" name="Template_MiddleBadgeLocked" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PanelList" class="panel" style="flex-grow: 1; width: 35%; height: 80%;" />
                <ui:VisualElement name="PanelInfo" style="flex-grow: 1; width: 20%; height: 80%;">
                    <ui:VisualElement class="panel panel_info">
                        <ui:Label tabindex="-1" text="ERA GOAL" display-tooltip-when-elided="true" class="text_classic" style="-unity-text-align: upper-center; flex-grow: 1; flex-shrink: 1;" />
                        <ui:Label tabindex="-1" text="Lorem ipsum blah blah blah blah blah blah." display-tooltip-when-elided="true" style="-unity-text-align: upper-center; flex-shrink: 1; flex-grow: 1; white-space: normal;" />
                        <ui:Button text="Button" display-tooltip-when-elided="true" style="justify-content: flex-end; align-items: stretch; flex-shrink: 1; flex-grow: 0;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel panel_info" style="flex-grow: 1; flex-basis: 100%; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                    <ui:VisualElement name="VisualElement" class="panel panel_info" style="flex-grow: 1; flex-basis: 100%; border-top-left-radius: 0; border-top-right-radius: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; flex-basis: 20%;" />
    </ui:VisualElement>
</ui:UXML>
